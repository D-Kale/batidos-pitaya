---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Batidos Pitaya — Los mejores batidos de pura fruta de Nicaragua",
  description = "Batidos de pura fruta, waffles, smoothie bowls y limonadas. +5,000 miembros del Club Pitaya. 14 sucursales en Nicaragua.",
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/images/site/Logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Instrument+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    
    <!-- Open Graph / Meta Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/site/hero-smoothies.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/site/hero-smoothies.jpg" />

    <!-- Schema.org Restaurant structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Restaurant",
      "name": "Batidos Pitaya",
      "description": "Los mejores batidos de pura fruta natural en Nicaragua.",
      "image": "/images/site/hero-smoothies.jpg",
      "servesCuisine": ["Smoothies", "Juice", "Waffles", "Healthy"],
      "telephone": "+50576859041",
      "priceRange": "C$ 99 - C$ 229"
    })} />

    <ClientRouter />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
