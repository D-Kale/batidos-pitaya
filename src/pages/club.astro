---
import Base from "../layouts/Base.astro";
import { club, site } from "../data";

const steps = [
  {
    step: "1",
    title: "Registrate en 1 minuto",
    desc: "Escribinos al WhatsApp con tu nombre y fecha de cumpleaños para activar tu membresía digital.",
    icon: "📱",
  },
  {
    step: "2",
    title: "Mencioná tu número",
    desc: "En cada visita a cualquiera de nuestras 14 sucursales, indicá tu número antes de pagar y sumá puntos al instante.",
    icon: "🥤",
  },
  {
    step: "3",
    title: "Canjeá y disfrutá",
    desc: "Cambiá tus puntos acumulados por batidos gratis, toppings, waffles y celebrá tu cumple con regalo.",
    icon: "🎉",
  },
];
---

<Base
  title="Club Pitaya — Batidos Pitaya"
  description="Sumate al Club Pitaya: +5,000 miembros, puntos por cada compra, combos exclusivos y un batido gratis en tu cumpleaños."
>
  <!-- HERO CLUB -->
  <section class="relative overflow-hidden bg-gradient-to-b from-leaf-deep via-leaf to-leaf py-16 text-cream md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <div class="grid items-center gap-12 lg:grid-cols-12">
        <div class="text-center lg:col-span-7 lg:text-left">
          <p class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-sun backdrop-blur">
            ★ {club.members} miembros acumulando
          </p>
          <h1 class="font-display mt-5 text-4xl font-black leading-tight sm:text-5xl md:text-6xl text-white">
            Cada batido te acerca al próximo <span class="text-sun">gratis</span>
          </h1>
          <p class="mt-5 text-base text-cream/85 md:text-lg max-w-xl">
            El programa de lealtad donde tus compras suman puntos reales canjeables por productos enteros,
            además de beneficios con aliados y tu batido de cumpleaños de regalo.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center lg:justify-start gap-4">
            <a
              href={`https://wa.me/50576859041/?text=${encodeURIComponent("Hola Batidos Pitaya, quiero registrarme al Club Pitaya. Me pueden compartir mas informacion por favor.")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full bg-pitaya px-8 py-4 font-bold text-white shadow-xl transition-all hover:scale-105 hover:bg-pitaya-deep"
            >
              Registrarme gratis al Club →
            </a>
            <a
              href="#como-funciona"
              class="rounded-full border border-white/30 bg-white/5 px-6 py-4 font-bold text-white backdrop-blur transition hover:bg-white/15"
            >
              ¿Cómo funciona?
            </a>
          </div>
        </div>

        <div class="relative flex justify-center lg:col-span-5">
          <div class="relative w-full max-w-xs sm:max-w-sm rounded-[2.5rem] bg-gradient-to-tr from-pitaya to-sun p-1 shadow-2xl transition hover:rotate-1">
            <div class="overflow-hidden rounded-[2.3rem] bg-leaf-deep p-6 text-cream">
              <div class="flex items-center justify-between border-b border-white/10 pb-4">
                <span class="font-display text-xl font-bold tracking-wider text-white">CLUB PITAYA</span>
                <span class="rounded-full bg-pitaya/30 px-3 py-1 text-xs font-bold text-sun">VIP MEMBER</span>
              </div>
              <div class="my-8 text-center">
                <p class="text-xs uppercase tracking-[0.2em] text-cream/60">Tus Puntos Pitaya</p>
                <p class="font-display mt-2 text-6xl font-black text-white">100</p>
                <p class="mt-2 text-xs font-semibold text-sun">¡Ya alcanzás un Batido Gratis!</p>
              </div>
              <div class="space-y-2 rounded-2xl bg-white/5 p-4 text-xs text-cream/75 border border-white/10">
                <div class="flex justify-between">
                  <span>Acumulación:</span>
                  <span class="font-bold text-white">10 a 25 pts / batido</span>
                </div>
                <div class="flex justify-between">
                  <span>Cumpleaños:</span>
                  <span class="font-bold text-pitaya">Batido Gratis 🎁</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PASO A PASO (UX PROGRESSION) -->
  <section id="como-funciona" class="mx-auto max-w-6xl px-5 py-20">
    <div class="text-center max-w-2xl mx-auto">
      <p class="text-xs font-bold uppercase tracking-[0.25em] text-pitaya">Simple y transparente</p>
      <h2 class="font-display mt-2 text-3xl font-black text-leaf sm:text-4xl">¿Cómo funciona el Club?</h2>
      <p class="mt-3 text-ink/70">Sin tarjetas plásticas que se pierden. Todo vinculado a tu número telefónico.</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {steps.map((s) => (
        <div class="relative rounded-3xl border border-leaf/10 bg-white p-7 shadow-sm transition hover:shadow-xl hover:border-pitaya/25">
          <div class="flex items-center justify-between mb-5">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-leaf-soft text-2xl">
              {s.icon}
            </span>
            <span class="font-display text-3xl font-black text-leaf/15">
              0{s.step}
            </span>
          </div>
          <h3 class="font-display text-xl font-bold text-leaf">{s.title}</h3>
          <p class="mt-2 text-sm text-ink/75 leading-relaxed">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- BENEFICIOS CLAVE -->
  <section class="bg-cream py-16">
    <div class="mx-auto max-w-6xl px-5">
      <h2 class="reveal font-display text-center text-3xl font-black text-leaf sm:text-4xl">
        Beneficios exclusivos por ser miembro
      </h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {club.benefits.map((b) => (
          <div class="reveal rounded-3xl border border-leaf/10 bg-white p-6 text-center shadow-sm transition hover:shadow-md">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-pitaya/10 text-3xl">
              {b.icon === "cup" && "🥤"}
              {b.icon === "waffle" && "🧇"}
              {b.icon === "cookie" && "🍪"}
              {b.icon === "gift" && "🎁"}
            </div>
            <h3 class="font-display text-lg font-bold text-leaf">{b.title}</h3>
            <p class="mt-2 text-sm font-bold text-pitaya">{b.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PUNTOS Y CANJE (TABLA CLARA) -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <div class="grid gap-12 lg:grid-cols-2">
      <!-- GANAR PUNTOS -->
      <div>
        <div class="mb-6">
          <span class="rounded-full bg-leaf/10 px-3 py-1 text-xs font-bold text-leaf uppercase tracking-wider">Paso 1: Sumar</span>
          <h2 class="font-display mt-2 text-3xl font-black text-leaf">¿Cuántos puntos gano?</h2>
          <p class="mt-2 text-sm text-ink/70">Sumás puntos en todas tus compras según el tamaño y tipo de producto:</p>
        </div>
        <div class="space-y-4">
          {club.pointsEarn.map((g) => (
            <div class="rounded-3xl border border-leaf/10 bg-white p-6 shadow-sm">
              <h3 class="font-display text-lg font-bold text-leaf flex items-center gap-2">
                <span class="text-pitaya">✦</span> {g.group}
              </h3>
              <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
                {g.items.map((it) => (
                  <li class="flex items-center gap-2 text-sm font-medium text-ink/80 bg-leaf-soft/50 px-3 py-2 rounded-xl">
                    <span>✓</span> {it}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- CANJEAR PUNTOS -->
      <div>
        <div class="mb-6">
          <span class="rounded-full bg-pitaya/10 px-3 py-1 text-xs font-bold text-pitaya uppercase tracking-wider">Paso 2: Canjear</span>
          <h2 class="font-display mt-2 text-3xl font-black text-leaf">¿Por qué puedo cambiarlos?</h2>
          <p class="mt-2 text-sm text-ink/70">Alcanzá tu meta de puntos y pedí tu premio en caja:</p>
        </div>
        <div class="overflow-hidden rounded-3xl border border-leaf/10 bg-white shadow-sm divide-y divide-leaf/5">
          {club.redeems.map((r) => (
            <div class="flex items-center justify-between p-5 transition hover:bg-leaf-soft/30">
              <div class="flex items-center gap-4">
                <span class="flex h-10 min-w-14 items-center justify-center rounded-2xl bg-pitaya font-display text-sm font-bold text-white shadow-sm">
                  {r.pts}
                </span>
                <span class="font-semibold text-leaf text-base">{r.reward}</span>
              </div>
              <span class="text-xs font-bold uppercase tracking-wider text-pitaya bg-pitaya/10 px-3 py-1 rounded-full">
                Premio
              </span>
            </div>
          ))}
        </div>

        <!-- ALIADO -->
        <div class="mt-6 rounded-3xl bg-gradient-to-br from-leaf to-leaf-deep p-6 text-cream shadow-md">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-sun">Beneficio con Aliados</span>
            <span class="rounded-full bg-white/20 px-3 py-0.5 text-xs font-semibold">Exclusivo Club</span>
          </div>
          <p class="font-display mt-3 text-2xl font-bold text-white">{club.partner.discount}</p>
          <p class="mt-1 text-sm text-cream/80">Válido en compras directas en {club.partner.name}</p>
          <div class="mt-4 overflow-hidden rounded-2xl bg-white/10 p-2">
            <img src="/images/site/Davilabanner4.webp" alt="Aliado Dávila" class="w-full h-auto object-contain rounded-xl" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- REGLAS CLARAS -->
  <section class="bg-leaf-soft py-16">
    <div class="mx-auto max-w-4xl px-5">
      <h2 class="font-display text-center text-2xl font-bold text-leaf">Condiciones del programa</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {club.rules.map((r) => (
          <div class="flex gap-3 rounded-2xl bg-white p-4 text-sm text-ink/75 shadow-sm">
            <span class="text-pitaya font-bold">•</span>
            <span>{r}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-gradient-to-r from-pitaya to-pitaya-deep py-16 text-center text-white">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="font-display text-3xl font-black md:text-5xl">¿Listo para unirte al Club?</h2>
      <p class="mt-4 text-white/90 max-w-lg mx-auto text-base">
        Registrate hoy mismo en WhatsApp y empezá a sumar puntos desde tu primer batido.
      </p>
      <a
        href={site.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-block rounded-full bg-white px-9 py-4 font-bold text-pitaya-deep shadow-xl transition-all hover:scale-105 hover:bg-cream"
      >
        Registrarme al Club por WhatsApp →
      </a>
    </div>
  </section>
</Base>
