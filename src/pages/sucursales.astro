---
import Base from "../layouts/Base.astro";
import BranchesDirectory from "../components/BranchesDirectory";
import { branches, site } from "../data";
---

<Base
  title="Sucursales — Batidos Pitaya"
  description="14 sucursales de Batidos Pitaya en Managua, Granada, Masaya, Estelí, Matagalpa y León. Direcciones, horarios y pedidos online."
>
  <section class="relative overflow-hidden bg-gradient-to-b from-leaf-deep via-leaf to-leaf pb-16 pt-20 text-center text-cream">
    <div class="mx-auto max-w-3xl px-5 relative z-10">
      <p class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-sun backdrop-blur">
        ★ Cobertura Nacional
      </p>
      <h1 class="font-display mt-4 text-5xl font-black md:text-6xl text-white">Nuestras Sucursales</h1>
      <p class="mt-4 text-cream/80 text-base md:text-lg max-w-xl mx-auto">
        14 puntos de encuentro en 6 ciudades de Nicaragua para que nunca te falte tu dosis de pura fruta.
      </p>
    </div>
  </section>

  <!-- Interactive Directory with Search and Tabs -->
  <BranchesDirectory branches={branches} client:load />

  <section class="bg-gradient-to-r from-pitaya to-pitaya-deep py-16 text-center text-white">
    <div class="mx-auto max-w-2xl px-5">
      <h2 class="font-display text-3xl font-black md:text-4xl">¿Querés tu batido a domicilio?</h2>
      <p class="mt-3 text-white/90 text-sm md:text-base">
        Si no tenés una sucursal cerca o preferís quedarte en casa, pedí directamente por WhatsApp al {site.phone}.
      </p>
      <a
        href={site.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-block rounded-full bg-white px-9 py-4 font-bold text-pitaya-deep shadow-xl transition-all hover:scale-105 hover:bg-cream"
      >
        Pedir delivery por WhatsApp →
      </a>
    </div>
  </section>
</Base>
